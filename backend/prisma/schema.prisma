generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  OPEN
  CLOSED
}

enum SettlementStatus {
  PENDING
  PAID
}

enum FlatGroupType {
  FLAT
  TRIP
  PARTY
  OFFICE
}

enum ChoreFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  isGuest      Boolean  @default(false)
  createdAt    DateTime @default(now())

  flatsAdmin      Flat[]         @relation("FlatAdmin")
  flatMembers     FlatMember[]
  booksCreated    Book[]         @relation("BookCreator")
  expensesPaid    Expense[]      @relation("ExpensePayer")
  expensesAdded   Expense[]      @relation("ExpenseAdder")
  expenseSplits   ExpenseSplit[]
  settlementsFrom Settlement[]   @relation("SettlementFrom")
  settlementsTo   Settlement[]   @relation("SettlementTo")
  pollsCreated    Poll[]         @relation("PollCreator")
  pollVotes       PollVote[]     @relation("PollVoter")
  choresCreated   Chore[]        @relation("ChoreCreator")
  choresAssigned  Chore[]        @relation("ChoreAssignee")
  tasksCreated    Task[]         @relation("TaskCreator")
  tasksAssigned   Task[]         @relation("TaskAssignee")
  swapsRequested  TaskSwap[]     @relation("SwapRequester")
  swapsTargeted   TaskSwap[]     @relation("SwapTarget")
  taskHistories   TaskHistory[]
  taskPreferences TaskPreference[]
  shoppingAdded   ShoppingItem[] @relation("ShoppingAdder")
  shoppingBought  ShoppingItem[] @relation("ShoppingBuyer")
}

model Flat {
  id         Int           @id @default(autoincrement())
  name       String
  inviteCode String        @unique
  adminId    Int
  admin      User          @relation("FlatAdmin", fields: [adminId], references: [id])
  groupType  FlatGroupType @default(FLAT)
  createdAt  DateTime      @default(now())

  members         FlatMember[]
  books           Book[]
  polls           Poll[]
  chores          Chore[]
  tasks           Task[]
  taskHistories   TaskHistory[]
  taskPreferences TaskPreference[]
  shoppingItems   ShoppingItem[]
}

model FlatMember {
  id       Int      @id @default(autoincrement())
  flatId   Int
  userId   Int
  joinedAt DateTime @default(now())

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flatId, userId])
}

model Book {
  id        Int        @id @default(autoincrement())
  flatId    Int
  name      String
  status    BookStatus @default(OPEN)
  createdBy Int
  createdAt DateTime   @default(now())
  closedAt  DateTime?

  flat        Flat         @relation(fields: [flatId], references: [id], onDelete: Cascade)
  creator     User         @relation("BookCreator", fields: [createdBy], references: [id])
  expenses    Expense[]
  settlements Settlement[]
  budgets     BookBudget[]
}

model Expense {
  id         Int      @id @default(autoincrement())
  bookId     Int
  paidById   Int
  addedById  Int
  amount     Decimal  @db.Decimal(10, 2)
  category   String
  remarks    String?
  createdAt  DateTime @default(now())

  book    Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  paidBy  User           @relation("ExpensePayer", fields: [paidById], references: [id])
  addedBy User           @relation("ExpenseAdder", fields: [addedById], references: [id])
  splits  ExpenseSplit[]
}

model ExpenseSplit {
  id          Int     @id @default(autoincrement())
  expenseId   Int
  userId      Int
  shareAmount Decimal @db.Decimal(10, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model Settlement {
  id         Int              @id @default(autoincrement())
  bookId     Int
  fromUserId Int
  toUserId   Int
  amount     Decimal          @db.Decimal(10, 2)
  status     SettlementStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime         @default(now())

  book     Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  fromUser User @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("SettlementTo", fields: [toUserId], references: [id])
}

model Poll {
  id        Int       @id @default(autoincrement())
  flatId    Int
  question  String
  createdBy Int
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  flat    Flat         @relation(fields: [flatId], references: [id], onDelete: Cascade)
  creator User         @relation("PollCreator", fields: [createdBy], references: [id])
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     Int    @id @default(autoincrement())
  pollId Int
  label  String

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id       Int      @id @default(autoincrement())
  pollId   Int
  optionId Int
  userId   Int
  votedAt  DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation("PollVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Chore {
  id             Int            @id @default(autoincrement())
  flatId         Int
  title          String
  description    String?
  frequency      ChoreFrequency @default(WEEKLY)
  assignedUserId Int?
  createdBy      Int
  isCompleted    Boolean        @default(false)
  dueDate        DateTime?
  createdAt      DateTime       @default(now())

  flat         Flat  @relation(fields: [flatId], references: [id], onDelete: Cascade)
  creator      User  @relation("ChoreCreator", fields: [createdBy], references: [id])
  assignedUser User? @relation("ChoreAssignee", fields: [assignedUserId], references: [id])
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskType {
  ONE_TIME
  RECURRING
  ROTATING
}

enum TaskAssignmentType {
  MANUAL
  AUTO_FAIR
  ROTATING
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
  SKIPPED
}

enum SwapStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Task {
  id             Int                @id @default(autoincrement())
  flatId         Int
  title          String
  description    String?
  category       String             @default("Other")
  dueDate        DateTime
  dueTime        String?            @default("19:00")
  taskType       TaskType           @default(ONE_TIME)
  repeatInterval String?
  difficulty     TaskDifficulty     @default(MEDIUM)
  points         Int                @default(3)
  assignmentType TaskAssignmentType @default(MANUAL)
  assignedUserId Int?
  createdBy      Int
  status         TaskStatus         @default(PENDING)
  completedAt    DateTime?
  createdAt      DateTime           @default(now())

  flat         Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)
  creator      User          @relation("TaskCreator", fields: [createdBy], references: [id])
  assignedUser User?         @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  swaps        TaskSwap[]
  histories    TaskHistory[]
}

model TaskSwap {
  id          Int        @id @default(autoincrement())
  taskId      Int
  requesterId Int
  targetId    Int
  reason      String?
  status      SwapStatus @default(PENDING)
  createdAt   DateTime   @default(now())

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requester User @relation("SwapRequester", fields: [requesterId], references: [id])
  target    User @relation("SwapTarget", fields: [targetId], references: [id])
}

model TaskHistory {
  id           Int      @id @default(autoincrement())
  taskId       Int
  flatId       Int
  userId       Int
  action       String
  pointsEarned Int      @default(0)
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskPreference {
  id                  Int      @id @default(autoincrement())
  flatId              Int
  userId              Int
  availableDays       String   @default("Mon,Tue,Wed,Thu,Fri,Sat,Sun")
  preferredCategories String   @default("")
  avoidCategories     String   @default("")
  preferredTime       String   @default("ANY")
  updatedAt           DateTime @updatedAt

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flatId, userId])
}

model ShoppingItem {
  id         Int      @id @default(autoincrement())
  flatId     Int
  title      String
  quantity   String?
  isBought   Boolean  @default(false)
  boughtById Int?
  addedById  Int
  expenseId  Int?
  createdAt  DateTime @default(now())

  flat     Flat  @relation(fields: [flatId], references: [id], onDelete: Cascade)
  addedBy  User  @relation("ShoppingAdder", fields: [addedById], references: [id])
  boughtBy User? @relation("ShoppingBuyer", fields: [boughtById], references: [id])
}

model BookBudget {
  id          Int      @id @default(autoincrement())
  bookId      Int
  category    String
  amountLimit Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, category])
}
